{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "notepad.md",
  "version": "1.4.3",
  "identifier": "com.notepadmd.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "notepad.md",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 360,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' https: data: http://localimg.localhost localimg:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
